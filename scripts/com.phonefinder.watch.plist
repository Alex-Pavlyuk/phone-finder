<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.phonefinder.watch</string>

  <!-- Альтернатива PhoneFinder.app: прогоны идут без запущенного приложения.
       Ставить оба сразу не нужно — они будут опрашивать магазины вдвойне.

       __ROOT__ — абсолютный путь к папке проекта; launchd относительных не
       понимает. Подставить и установить одной командой:
         sed "s|__ROOT__|$(pwd)|g" scripts/com.phonefinder.watch.plist \
           > ~/Library/LaunchAgents/com.phonefinder.watch.plist \
           && launchctl load -w ~/Library/LaunchAgents/com.phonefinder.watch.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/run.sh</string>
  </array>

  <!-- Каждые 90 минут: телефоны выходят не каждый час -->
  <key>StartInterval</key>
  <integer>5400</integer>

  <!-- Догнать пропущенный запуск, если Mac спал -->
  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>StandardOutPath</key>
  <string>__ROOT__/data/watch.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/watch.log</string>
</dict>
</plist>
